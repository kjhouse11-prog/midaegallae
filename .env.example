# Supabase → Project Settings → API 에서 복사. 비워 두면 데모 모드로 실행됩니다.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# 운영자(관리자) 이메일, 쉼표로 구분 (예: admin@mgood.co.kr)
VITE_ADMIN_EMAILS=
# 유료 서비스 결제: test(테스트 결제) · off(출시 알림 신청) · live(PG 연동 후). 비우면 웹=test, 앱=off
VITE_PAYMENT_MODE=
# 고객센터 이메일 (정보 수정 요청·탈퇴 문의)
VITE_SUPPORT_EMAIL=
# AI 작품 진단: claude 로 두면 Supabase Edge Function(analyze-artwork) 사용, 비우면 데모 진단
VITE_AI_ANALYSIS=
